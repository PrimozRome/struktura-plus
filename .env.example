# Pošiljanje povpraševanj (Resend)
#
# Skrivnosti NE sodijo v repozitorij. Za krajevni razvoj naredi .env.local
# (v .gitignore je) in vanj prepiši spodnje vrstice s pravimi vrednostmi,
# na Vercelu pa jih nastavi pod Settings → Environment Variables.

# Ključ iz resend.com → API Keys. Za produkcijo zadošča pravica "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Pošiljatelj. Domena mora biti v Resendu potrjena (SPF in DKIM), sicer
# pošiljanje ne uspe. Neobvezno — privzeto se vzame naslov iz business.ts.
POSTA_OD="Struktura Plus <info@strukturaplus.si>"

# Prejemnik povpraševanj. Neobvezno — privzeto naslov iz business.ts.
POSTA_ZA=info@strukturaplus.si
